# Any model you've pulled with `ollama pull <name>` (see `ollama list`)
OLLAMA_MODEL=gpt-oss:20b

# Ollama server address. Use the other machine's IP if the model runs there,
# e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://localhost:11434

# How much text (in tokens) the chat model can read at once. Ollama's default of 4096
# is too small and silently drops part of the documents.
OLLAMA_NUM_CTX=16384

# How many chunks (e.g. spreadsheet rows) to give the AI for each question
TOP_K=8

# Model that turns text into vectors for Qdrant (pull it with `ollama pull nomic-embed-text`)
# If you change it, delete the qdrant_data folder and run ingest.py again.
EMBEDDING_MODEL=nomic-embed-text

# Qdrant collection name
QDRANT_COLLECTION=documents

# Local database folder (used when QDRANT_URL is not set)
QDRANT_PATH=qdrant_data

# Port for the web interface (server.py)
PORT=8000

# Optional: use a Qdrant server instead of the local folder, e.g. one running in Docker
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
