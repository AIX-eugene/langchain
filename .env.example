# Copy this file to .env and change what you need. Every setting is optional.

# ---- Ollama (runs the AI models) ----
# Ollama server address. Use another computer's IP if the models run there, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://192.168.1.83:11434

# Step 1: the vision model that describes the ad image
VISION_MODEL=deepseek-r1:32b 

# Step 2: the model that checks the description against the ASC rules (should support "tools")
JUDGE_MODEL=deepseek-r1:32b 

# How much text (tokens) the judge can read at once. Its instructions alone are about 8,000 tokens.
# 16384 fits a 16 GB graphics card; larger values spill onto the CPU and get much slower.
JUDGE_NUM_CTX=16384

# How much text (tokens) the vision model can read and write at once
VISION_NUM_CTX=8192

# Image checks retrieve guidelines first, then make one bounded judgment.
# Separate from chat reasoning; medium prioritizes evidence assessment.
IMAGE_JUDGE_REASONING=medium
IMAGE_JUDGE_MAX_TOKENS=6144
VISION_MAX_TOKENS=4096
IMAGE_SEED=42

# Model that turns search text into vectors. MUST be the same model the guidelines were stored with.
EMBEDDING_MODEL=nomic-embed-text

# ---- Qdrant (holds the ASC guidelines) ----
# The Qdrant server (the Docker container n8n also uses)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Collection with the ASC Guidebook passages
QDRANT_COLLECTION=asc_guidelines

# Passages per search, and the budget for the general model-led search loop.
# The image path instead pre-retrieves 2-3 focused ASC searches before one judgment.
TOP_K=3
MAX_SEARCHES=5

# ---- Web page ----
PORT=8000
MAX_IMAGE_MB=20

# Maximum document upload size in MB
MAX_DOCUMENT_MB=20

# Rolling context ceiling; reduced to reserve instructions, evidence and output.
CHAT_CONTEXT_LIMIT=8000
CHAT_MAX_TOKENS=512
